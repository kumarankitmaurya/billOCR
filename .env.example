# REQUIRED. Groq is the only OCR provider — there is no fallback, so without
# this key no bill can be read. Left as the `your_..._here` placeholder a key
# counts as UNSET rather than as configured-but-broken (see _api_key in
# app/config.py).
GROQ_API_KEY=your_groq_api_key_here

# Postgres holding the book of record (supplier/company/bill/line). Use the
# POOLED Neon endpoint here — the hostname with `-pooler` in it. The direct
# endpoint (same string without `-pooler`) is only for migrations, which is
# what scripts/migrate_sqlite_to_neon.py expects.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Origins allowed to call this API, comma-separated. SET THIS to your
# frontend's real origin (e.g. https://billocr-ui.vercel.app): left unset it
# still defaults to "*" in app/config.py, which lets any site on the internet
# call this API and read the whole book. Tightening that default is tracked
# as a separate fix.
CORS_ORIGINS=

# Alternative for when the caller's origin isn't a fixed string. Vercel gives
# every preview deployment its own hostname, so an exact list only matches
# production. Scope it to your own project, not all of vercel.app:
#   CORS_ORIGIN_REGEX=https://billocr-ui-[a-z0-9-]+\.vercel\.app
# Neither is needed if the frontend proxies /api/* to this service through a
# Vercel rewrite — the browser then makes no cross-origin request at all.
CORS_ORIGIN_REGEX=

# Create the schema at startup. Leave true for local dev and the first deploy;
# set false once the schema exists, so a serverless cold start stops re-running
# CREATE TABLE and taking an advisory lock every time (~2.5s).
DB_AUTO_INIT=true

# Seconds a request waits for a database connection before giving up. Short
# on purpose: with an unreachable database, the pool's own default made every
# request hang 30s before returning the 503 it was always going to return.
DB_CONNECT_TIMEOUT=8

# --- The two credentials ---
#
# REQUIRED. Gates the API at all, as the X-App-Password header on every
# request. Left blank the service refuses every request with a 503 rather
# than serving the whole book of record to anyone who finds the URL. Shop
# staff get this one. Set it for local development too.
APP_PASSWORD=

# Additionally unlocks base price (rate) — what the shop paid — in
# GET /api/bills/search, as the X-Admin-Password header. The owner gets this
# one. Leave blank to disable base-price access entirely: an empty header
# value never matches an empty password, so `rate` is simply never returned.
ADMIN_PASSWORD=

# --- The shop's pricing rule (app/services/pricing.py) ---
# Defaults the review screen pre-fills; every one stays editable per line.
# Changing them affects new scans only, never a price already saved.
#   margin is 15% under 1500 and 17% at or above, tested against the BILL RATE
#   over 1000:  nearest 5 of (computed + 8), or the next 20 if that ends in 05
#   up to 1000: rounded UP to the next 5, no nudge
DEFAULT_TAX_PCT=5
MARGIN_THRESHOLD=1500
MARGIN_PCT_BELOW=15
MARGIN_PCT_ABOVE=17
SELL_PRICE_NUDGE=8
SELL_PRICE_ROUND_TO=5
# The nudge applies only above this COMPUTED price. At or below it the price
# is rounded UP instead, which keeps it above the computed figure without one.
SELL_PRICE_NUDGE_ABOVE=1000
# Where a dear price landing on x05 (e.g. 2005) is pushed to instead.
SELL_PRICE_UGLY_STEP=20

# --- Upload limits ---
# Each image costs an OCR call and is extracted serially at 10-20s, so the
# batch is capped. Raising MAX_UPLOAD_FILES risks outliving the platform's
# request timeout.
MAX_UPLOAD_FILES=1
# Per file, and across the whole request. MAX_REQUEST_BYTES sits just under
# Vercel's 4.5MB function body limit, which is enforced by the platform before
# any application code runs. A 2.7MB phone photo fits; two do not — billOCR-ui
# must downscale before upload. Server-side redaction cannot help with this:
# it runs after the body has already arrived.
MAX_UPLOAD_BYTES=4194304
MAX_REQUEST_BYTES=4194304

# Serve /docs and /openapi.json. Off by default — they enumerate every
# endpoint, and /health is the liveness probe. Set true for local work.
ENABLE_DOCS=false
