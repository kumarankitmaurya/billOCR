# Set one or both API keys. The strategy module will auto-select
# the best available provider, or the user can pick from the UI.
# Left as the `your_..._here` placeholder, a key counts as UNSET rather
# than as a configured-but-broken one (see _api_key in app/config.py).
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Postgres holding the book of record (supplier/company/bill/line). Use the
# POOLED Neon endpoint here — the hostname with `-pooler` in it. The direct
# endpoint (same string without `-pooler`) is only for migrations, which is
# what scripts/migrate_sqlite_to_neon.py expects.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Origins allowed to call this API, comma-separated. SET THIS to your
# frontend's real origin (e.g. https://billocr-ui.vercel.app): left unset it
# still defaults to "*" in app/config.py, which lets any site on the internet
# call this API and read the whole book. Tightening that default is tracked
# as a separate fix.
CORS_ORIGINS=

# Unlocks base price (rate) in GET /api/bills/search when sent as the
# X-Admin-Password header. Leave blank to disable admin access entirely —
# an empty header value never matches an empty password.
ADMIN_PASSWORD=
