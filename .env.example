# Set one or both API keys. The strategy module will auto-select
# the best available provider, or the user can pick from the UI.
# Left as the `your_..._here` placeholder, a key counts as UNSET rather
# than as a configured-but-broken one (see _api_key in app/config.py).
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Postgres holding the book of record (supplier/company/bill/line). Use the
# POOLED Neon endpoint here — the hostname with `-pooler` in it. The direct
# endpoint (same string without `-pooler`) is only for migrations, which is
# what scripts/migrate_sqlite_to_neon.py expects.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Origins allowed to call this API, comma-separated. SET THIS to your
# frontend's real origin (e.g. https://billocr-ui.vercel.app): left unset it
# still defaults to "*" in app/config.py, which lets any site on the internet
# call this API and read the whole book. Tightening that default is tracked
# as a separate fix.
CORS_ORIGINS=

# --- The two credentials ---
#
# REQUIRED. Gates the API at all, as the X-App-Password header on every
# request. Left blank the service refuses every request with a 503 rather
# than serving the whole book of record to anyone who finds the URL. Shop
# staff get this one. Set it for local development too.
APP_PASSWORD=

# Additionally unlocks base price (rate) — what the shop paid — in
# GET /api/bills/search, as the X-Admin-Password header. The owner gets this
# one. Leave blank to disable base-price access entirely: an empty header
# value never matches an empty password, so `rate` is simply never returned.
ADMIN_PASSWORD=

# --- Upload limits ---
# Each image costs an OCR call and is extracted serially at 10-20s, so the
# batch is capped. Raising MAX_UPLOAD_FILES risks outliving the platform's
# request timeout.
MAX_UPLOAD_FILES=3
# Per file, and across the whole request. MAX_REQUEST_BYTES sits just under
# Vercel's 4.5MB function body limit, which is enforced by the platform before
# any application code runs. A 2.7MB phone photo fits; two do not — billOCR-ui
# must downscale before upload. Server-side redaction cannot help with this:
# it runs after the body has already arrived.
MAX_UPLOAD_BYTES=4194304
MAX_REQUEST_BYTES=4194304

# Serve /docs and /openapi.json. Off by default — they enumerate every
# endpoint, and /health is the liveness probe. Set true for local work.
ENABLE_DOCS=false
